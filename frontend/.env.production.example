# URL đầy đủ của backend API (domain thực của server production)
NEXT_PUBLIC_API_URL=https://api.chuanphat.vn

# Mock data — BẮT BUỘC false trong production
NEXT_PUBLIC_ENABLE_MOCK=false

# Mock login — BẮT BUỘC false trong production
NEXT_PUBLIC_ENABLE_MOCK_LOGIN=false
