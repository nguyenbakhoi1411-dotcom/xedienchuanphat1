# ============================================================
# Frontend Environment Variables — Chuẩn Phát ERP
# Sao chép file này thành .env.local và điền giá trị thực
# KHÔNG commit .env.local lên Git
# ============================================================

# URL của backend API
NEXT_PUBLIC_API_URL=http://localhost:8080

# Mock data — CHỈ bật trong development (true/false)
# Production BẮT BUỘC để false
NEXT_PUBLIC_ENABLE_MOCK=false

# Mock login — CHỈ bật trong development (true/false)
# Production BẮT BUỘC để false
NEXT_PUBLIC_ENABLE_MOCK_LOGIN=false
